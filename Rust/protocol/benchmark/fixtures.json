  "state_cases": [
    {"case":"idle valid configure", "expected":"APPLIED; bind owner; start schedules; reset run counters"},
    {"case":"same configure ID and identical fields", "expected":"ALREADY_APPLIED; do not reset counters, schedules or lease"},
    {"case":"same control ID but different kind/fields", "expected":"REQUEST_CONFLICT; no state change"},
    {"case":"older control ID after renew", "expected":"STALE_CONTROL; no state change"},
    {"case":"second owner while active", "expected":"BUSY; no state change"},
    {"case":"new configure while already active", "expected":"BUSY; stop and create a new session first"},
    {"case":"fresh owner renewal before expiry", "expected":"APPLIED; extend original lease duration; preserve schedules/counters"},
    {"case":"duplicate renewal", "expected":"ALREADY_APPLIED; no lease extension"},
    {"case":"renew at exact expiry", "expected":"STALE_RUN; expire before processing"},
    {"case":"probe after deadline", "expected":"no probe reply; expire and advance epoch"},
    {"case":"stop then delayed configure from same old epoch", "expected":"STALE_RUN; no restart"},
    {"case":"old STOP while another run is active", "expected":"STALE_RUN; new run unaffected"},
    {"case":"link/configuration loss", "expected":"end run, clear queues, advance epoch; remain idle on reconnect"},
    {"case":"epoch exhausted", "expected":"capabilities available=false; reject configure until reboot"},
    {"case":"control ID exhausted", "expected":"stop with final available ID or expire; never wrap in session"}
  ]
