{
  "mode": "stress",
  "base": {
    "target": "127.0.0.1",
    "target_kind": "host",
    "interface": "127.0.0.1",
    "format": "protobuf",
    "crc": "on",
    "outstanding": 128,
    "deadline_ms": 1000,
    "lease_ms": 10000,
    "warmup": 1,
    "report_interval": 1
  },
  "payloads": [0, 64, 256, 512],
  "rates": [
    {"command_hz": 100, "status_period_us": 10000, "health_period_us": 100000},
    {"command_hz": 500, "status_period_us": 2000, "health_period_us": 20000},
    {"command_hz": 1000, "status_period_us": 1000, "health_period_us": 10000}
  ],
  "dwell_seconds": 30,
  "recovery": {
    "payload_bytes": 0,
    "command_hz": 10,
    "status_period_us": 100000,
    "health_period_us": 100000,
    "duration_seconds": 10
  },
  "stop_on_failure": true,
  "thresholds": {
    "max_p99_ms": 100,
    "max_deadline_fraction": 0.01,
    "min_send_ratio": 0.95,
    "max_stale_fraction": 0.05,
    "max_gap_fraction": 0.01,
    "live_min_seconds": 5
  }
}
