{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Rust: provision SSH keys",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\provision_ssh.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Rust: build release",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Rust: provision SSH keys"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Rust: run unit tests",
            "type": "process",
            "command": "cargo",
            "args": [
                "test",
                "--locked",
                "--no-default-features",
                "--features",
                "host-tests",
                "--test",
                "host",
                "--target",
                "x86_64-pc-windows-msvc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Rust: flash board",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\flash.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Rust: provision SSH keys"
            ],
            "problemMatcher": []
        },
        {
            "label": "Rust: connect with SSH",
            "type": "process",
            "command": "ssh.exe",
            "args": [
                "-i",
                "${workspaceFolder}\\.ssh\\client_ed25519",
                "-p",
                "2222",
                "board@${input:boardIp}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Rust: test UDP echo",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\udp_echo_test.ps1",
                "-BoardIp",
                "${input:boardIp}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "boardIp",
            "type": "promptString",
            "description": "Current DHCP address of the board",
            "default": "192.168.68.57"
        }
    ]
}
